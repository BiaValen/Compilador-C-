/* Teste com while e operadores */
int fatorial(int n) {
    int resultado;
    resultado = 1;
    
    while (n > 1) {
        resultado = resultado * n;
        n = n - 1;
    }
    
    output(resultado);
    return resultado;
}

int main(void) {
    int numerodigitado;
    int x;
    
    /* Solicita que o usuário digite um valor (Lê do endereço 2044) */
    numerodigitado = input();
    
    /* Calcula o fatorial usando o valor fornecido */
    x = fatorial(numerodigitado);
    
    if (x >= 100) {
        return 1;
    } else {
        return 0;
    }
}
