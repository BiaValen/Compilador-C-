/* Um programa para calcular o mdc
    segundo o algoritmo de euclides.

    Le x e y via input() (chaves + Enter, um de cada vez) e
    devolve gcd(x,y) via output().

    Testado com entrada: 48, 18
    Saida esperada:      6 */

int gcd (int u, int v)
{
	if (v == 0) {return u;}
	else return gcd(v,u-u/v*v);
}

void main(void)
{	int x; int y;

    x = input();
    y = input();
    output(gcd(x,y));
}