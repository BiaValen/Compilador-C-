/* Teste abrangente para o compilador C-
   Cobre:
   - vetores globais e vetores como parametro
   - funcoes int e void
   - chamadas aninhadas e recursao
   - while, if e else
   - input e output
   - operadores + - * /
   - relacionais < <= > >= == !=
*/

int dados[6];
int copia[6];

int igual(int a, int b)
{
    if (a == b) {
        return 1;
    }
    else {
        return 0;
    }
}

int diferente(int a, int b)
{
    if (a != b) {
        return 1;
    }
    else {
        return 0;
    }
}

int maximo(int a, int b)
{
    if (a > b) {
        return a;
    }
    else {
        return b;
    }
}

int distancia(int a, int b)
{
    if (a >= b) {
        return a - b;
    }
    else {
        return b - a;
    }
}

int fib(int n)
{
    if (n <= 1) {
        return n;
    }
    else {
        return fib(n - 1) + fib(n - 2);
    }
}

int resto(int a, int b)
{
    int q; int r;
    q = a / b;
    r = a - q * b;
    return r;
}

int mdc(int a, int b)
{
    int r;
    while (b != 0) {
        r = resto(a, b);
        a = b;
        b = r;
    }
    return a;
}

void ler(int v[], int n)
{
    int i;
    i = 0;
    while (i < n) {
        v[i] = input();
        i = i + 1;
    }
}

void copiareverso(int origem[], int destino[], int n)
{
    int i; int j;
    i = 0;
    while (i < n) {
        j = n - 1 - i;
        destino[i] = origem[j];
        i = i + 1;
    }
}

int soma(int v[], int n)
{
    int i; int s;
    i = 0;
    s = 0;
    while (i < n) {
        s = s + v[i];
        i = i + 1;
    }
    return s;
}

int produto(int v[], int n)
{
    int i; int p;
    i = 0;
    p = 1;
    while (i < n) {
        if (v[i] > 0) {
            p = p * v[i];
        }
        else {
            p = p * 1;
        }
        i = i + 1;
    }
    return p;
}

void main(void)
{
    int s; int p; int m; int d; int f; int eq; int ne; int r; int g; int primeiro; int ultimo;

    ler(dados, 6);
    copiareverso(dados, copia, 6);

    s = soma(dados, 6);
    p = produto(dados, 6);
    m = maximo(dados[0], dados[5]);
    d = distancia(dados[1], dados[4]);
    f = fib(6);
    eq = igual(dados[2], dados[3]);
    ne = diferente(dados[2], dados[3]);
    r = resto(s, 5);
    g = mdc(s, p);
    primeiro = copia[0];
    ultimo = copia[5];

    output(s);
    output(p);
    output(m);
    output(d);
    output(f);
    output(eq);
    output(ne);
    output(r);
    output(g);
    output(primeiro);
    output(ultimo);
}
